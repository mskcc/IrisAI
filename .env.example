# IrisAI Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# In production (Open OnDemand), these are injected automatically by
# template/before.sh.erb at session start.
#
# NOTE: Full runtime requires a LiteLLM proxy, Open OnDemand, and Slurm.
# ──────────────────────────────────────────────────────────────────────────────

# --- LiteLLM Proxy (REQUIRED for app runtime) ---
# URL of your LiteLLM proxy instance
LITELLM_URL=http://<your-litellm-proxy-host>:8080

# SDK compatibility alias (same value as LITELLM_URL)
LITELLM_API_BASE=http://<your-litellm-proxy-host>:8080

# Per-user virtual key (generated by before.sh.erb via POST /key/generate at session start)
# See docs/ARCHITECTURE.md#litellm-virtual-key-authentication for how this is generated
LITELLM_VIRTUAL_KEY=sk-your-virtual-key-here

# --- Application Settings ---
IRISAI_APP_NAME=IrisAIdev
ENV=dev

# --- MCP Server Ports (auto-assigned at runtime via find_port) ---
MCP_FILE_PORT=8001
MCP_BIO_PROCESS_PORT=8004
MCP_SLURM_PORT=8003
MCP_CODE_EXECUTION_PORT=8005

# --- MCP Authentication ---
# Shared bearer token for MCP server <-> app communication (auto-generated at runtime)
MCP_SHARED_BEARER_TOKEN=your-random-32-char-token-here

# --- Optional: Web Search (SearXNG) ---
# SEARXNG_TOKEN=your-searxng-token
# SEARXNG_NGINX_PORT=8888
