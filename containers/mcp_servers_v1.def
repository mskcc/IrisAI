Bootstrap: localimage
From: /path/to/your/base-container.sif  # Replace with your base Singularity image path 

%post
  curl -1sLf 'https://repo.delinea.com/CTksOd7cEp3EF32y/rpm-redhat/setup.rpm.sh' | /bin/bash
  dnf install -y CentrifyDC

%environment
  export PATH="/opt/miniforge3/bin:$PATH"
  export CONDA_PREFIX="/opt/miniforge3"

%runscript
  # Default: activate environment and run command
  source /opt/miniforge3/bin/activate mcptool001
  exec "$@"

%startscript
  # For daemon mode - start all MCP servers dynamically
  exec /opt/start_mcp_servers.sh
