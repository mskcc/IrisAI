Bootstrap: docker
From: rockylinux:8.9

%files
  /admin/isvslurm/rpms/*.rpm /root/
  /etc/munge/munge.key /root/munge.key
  /usr/share/lmod/lmod/init/.modulespath /root/modulespath
  ${APP_DIR}/hpcagent02.yml /root/hpcagent02.yml

%post
  # User setup for Slurm compatibility
  useradd munge -u 600
  useradd slurm -u 601
  
  # Enable repositories (Rocky 8.9 specific)
  dnf install -y epel-release
  dnf config-manager --set-enabled powertools
  
  # Install system dependencies via DNF
  dnf groupinstall -y 'Development Tools'
  dnf install -y \
    git curl wget rsync \
    gcc gcc-c++ make cmake \
    openssl-devel libffi-devel \
    zlib-devel bzip2-devel \
    sqlite-devel readline-devel \
    tk-devel gdbm-devel \
    xz-devel expat-devel \
    libuuid-devel ncurses-devel \
    libX11-devel libXext-devel \
    libXrender-devel libICE-devel \
    libSM-devel fontconfig-devel \
    freetype-devel libpng-devel \
    libjpeg-turbo-devel \
    nodejs npm \
    cairo-devel pango-devel \
    gdk-pixbuf2-devel \
    atk-devel gtk3-devel
  
  # Install Slurm RPMs
  dnf -y install /root/*.rpm
  
  # Munge setup
  chown -R root:munge /etc/munge /var/log/munge /var/lib/munge /var/run/munge
  chmod 1770 /etc/munge /var/log/munge /var/lib/munge
  chmod 1775 /var/run/munge
  ln -s /tmp/munge /var/log/munge
  cp /root/munge.key /etc/munge/munge.key
  chmod 0400 /etc/munge/munge.key
  chown root:munge /etc/munge/munge.key
  
  # Lmod setup
  mkdir -p /usr/share/lmod/lmod/init/
  mv /root/modulespath /usr/share/lmod/lmod/init/.modulespath
  chmod 644 /usr/share/lmod/lmod/init/.modulespath
  chown root:root /usr/share/lmod/lmod/init/.modulespath
  
  # Link Slurm config
  ln -s /admin/isvslurm/etc/slurm /etc/slurm
  
  # Install Miniforge using the verified GitHub URL
  echo "Downloading Miniforge..."
  curl -L -O "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-$(uname)-$(uname -m).sh"
  
  # Verify download succeeded
  if [[ ! -f "Miniforge3-$(uname)-$(uname -m).sh" ]]; then
    echo "ERROR: Failed to download Miniforge"
    exit 1
  fi
  
  # Install Miniforge
  bash "Miniforge3-$(uname)-$(uname -m).sh" -b -p /opt/miniforge3
  rm "Miniforge3-$(uname)-$(uname -m).sh"
  
  # Initialize conda for bash
  /opt/miniforge3/bin/conda init bash
  
  # Create environment from your existing YAML file
  /opt/miniforge3/bin/conda env create -f /root/hpcagent02.yml -p /opt/miniforge3/envs/hpcagent02
  
  # Clean up
  dnf clean all
  /opt/miniforge3/bin/conda clean -afy
  rm /root/hpcagent02.yml

%environment
  export PATH="/opt/miniforge3/bin:$PATH"
  export CONDA_PREFIX="/opt/miniforge3"

%runscript
  # Default: activate environment and run chainlit
  source /opt/miniforge3/bin/activate hpcagent02
  exec "$@"

%startscript
  # For daemon mode
  source /opt/miniforge3/bin/activate hpcagent02
  chainlit run /external/app.py --host 0.0.0.0 --port ${NODE_SERVER_PORT:-8000} --root-path "/node/${host}/${port}"
